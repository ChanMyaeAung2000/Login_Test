# ============================================================
#  Root .gitignore — ONE repo for both Frontend and Backend
#  Patterns like **/node_modules/ match in every sub-folder.
# ============================================================

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Build output ----
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/

# ---- Environment variables (never commit secrets!) ----
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# ---- Logs ----
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Vite / bundler cache ----
.vite/
**/.vite/
*.local

# ---- Test coverage ----
coverage/
**/coverage/

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS files ----
.DS_Store
Thumbs.db
