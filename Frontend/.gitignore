# Frontend .gitignore (Vite + React + Tailwind)

# ---- Dependencies ----
node_modules/

# ---- Build output ----
dist/
dist-ssr/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Environment variables ----
.env
.env.*
!.env.example

# ---- Vite cache ----
.vite/
*.local

# ---- Test coverage ----
coverage/

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS files ----
.DS_Store
Thumbs.db
