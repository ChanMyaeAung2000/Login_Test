# Backend .gitignore (Node + Express + JWT)

# ---- Dependencies ----
node_modules/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ---- Environment variables (JWT secret will go here later!) ----
.env
.env.*
!.env.example

# ---- Build output ----
dist/
build/

# ---- Test coverage ----
coverage/

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS files ----
.DS_Store
Thumbs.db
