# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env

PORT=5000

# Use a long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

JWT_EXPIRES_IN=1h

# MongoDB connection string
# Local:
#   MONGO_URI=mongodb://127.0.0.1:27017/login_feature
# Atlas (cloud) — remember to URL-encode special characters in the password:
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/login_feature?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/login_feature
